{
  "name": "tuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tuit": "./bin/tuit"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "admin": "node src/admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "local": "node scripts/local.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "oidc-provider": "^9.12.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
